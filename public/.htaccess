# Apache config for the Infomaniak hosting of sprac.ch. Copied into dist/ by Vite.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

# HTTPS only
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

AddType application/manifest+json .webmanifest
AddType text/plain .txt
AddDefaultCharset utf-8

<IfModule mod_headers.c>
    # Headers a <meta> tag cannot set. The full Content-Security-Policy is in every page's <head>.
    Header always set Strict-Transport-Security "max-age=31536000"
    Header always set Content-Security-Policy "frame-ancestors 'none'"
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
    Header always set Cross-Origin-Opener-Policy "same-origin"

    # Vite's hashed build files never change; everything else is revalidated on each visit.
    <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(html|xml|txt|webmanifest)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>